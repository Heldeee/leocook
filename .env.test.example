# Valeurs à récupérer après `npm run supabase:start` puis `npx supabase status -o env`.
# Ne pas mettre les identifiants du projet cloud dans .env.test : Cypress doit viser
# l'instance locale pour garder les données cloud intactes.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<ANON_KEY_local>
